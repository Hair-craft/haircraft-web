# HairCraft storefront settings. Copy to .env.local for development.
# None of these reach the browser (no NEXT_PUBLIC_ prefix).

# The NestJS API, including /api/v1 (no trailing slash).
API_BASE_URL=http://localhost:3000/api/v1

# true: the shop is open. false: every page shows "Coming soon".
# Default: false in production (until launch), true in development.
STORE_OPEN=true

# Public address of the storefront (links, metadata).
# Default: https://haircraft.in in production, http://localhost:3001 otherwise.
SITE_URL=http://localhost:3001

# true: search engines may index the site. Leave false (the default) everywhere
# except the live site, so test and preview copies never appear in Google.
ALLOW_INDEXING=false

# Google Search Console: the code from its "HTML tag" verification (content="…").
# GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools: the code from its "HTML Meta Tag" verification (msvalidate.01).
# BING_SITE_VERIFICATION=

# How long one API call may take, in milliseconds (1000–60000). Default 10000.
API_TIMEOUT_MS=10000

# Free shipping from this order total (rupees), shown in marketing copy only.
# Must match the backend's FREE_SHIPPING_THRESHOLD; checkout always shows the
# real shipping. Leave empty to not mention an amount.
FREE_SHIPPING_THRESHOLD=1999

# Products per page on the shop's listing pages (1–100). Default 24.
PRODUCTS_PER_PAGE=24

# Only for a local production build (npm run build && npm start) against a
# local API: lets next/image optimise photos from localhost. Needed both when
# building and when starting the server. Never on a real server.
# ALLOW_LOCAL_IMAGES=true
